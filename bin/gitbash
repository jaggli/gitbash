#!/usr/bin/env bash
# gitbash - Interactive git utilities for bash with fzf-powered menus

# Resolve symlinks to get the actual script location
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
GITBASH_BIN="$SCRIPT_DIR/bin/gitbash"
COMMANDS_DIR="$SCRIPT_DIR/commands"
VERSION="$(grep -o '"version": *"[^"]*"' "$SCRIPT_DIR/package.json" | head -1 | cut -d'"' -f4)"
export SCRIPT_DIR GITBASH_BIN VERSION

# shellcheck source=../commands/_utils.sh
source "$COMMANDS_DIR/_utils.sh"

# Available commands
COMMANDS=(
    "branch"
    "cleanstash"
    "cleanup"
    "commit"
    "commits"
    "create"
    "pr"
    "repo"
    "stale"
    "stash"
    "stashes"
    "status"
    "switch"
    "unstash"
    "update"
)

is_command() {
    local cmd
    for cmd in "${COMMANDS[@]}"; do
        [[ "$cmd" == "$1" ]] && return 0
    done
    return 1
}

# =============================================================================
# Configuration wizard
# =============================================================================

# key|type|question
SETTINGS=(
    "GITBASH_CREATE_BRANCH_PREFIX|prefix|Branch prefix inserted between type and branch name (e.g. 'team' → feature/team/PROJ-123-fix-bug)"
    "GITBASH_CREATE_NO_ISSUE_PARSING|parsing|Parse Jira issue numbers into branch names? (yes/no)"
    "GITBASH_CREATE_ISSUE_PARSING_FALLBACK|text|Fallback issue prefix when no issue number is given"
    "GITBASH_CREATE_AUTO_PUSH|yesno|Push new branches to the remote right after 'create'? (yes/no)"
    "GITBASH_MERGE_COMMAND|command|Merge tool opened by 'update' on conflicts (not allowed in the committed .gitbashrc)"
    "GITBASH_THEME|theme|Theme for delta/bat previews (auto/dark/light)"
    "GITBASH_STALE_MONTHS|number|Stale remote branch threshold in months (used by 'stale')"
    "GITBASH_CLEANUP_DAYS|number|Stale local branch threshold in days (used by 'cleanup')"
    "GITBASH_PROTECTED_BRANCHES|text|Branches never offered for deletion (space-separated globs)"
    "GITBASH_BASE_BRANCH|text|Base branch (empty = detect from the remote's HEAD, then main/master)"
    "GITBASH_REMOTE|text|Remote name"
)

# Default value of a setting
setting_default() {
    case "$1" in
        GITBASH_CREATE_NO_ISSUE_PARSING) echo "no" ;;
        GITBASH_CREATE_ISSUE_PARSING_FALLBACK) echo "NOISSUE" ;;
        GITBASH_CREATE_AUTO_PUSH) echo "yes" ;;
        GITBASH_MERGE_COMMAND) echo "fork" ;;
        GITBASH_THEME) echo "auto" ;;
        GITBASH_STALE_MONTHS) echo "3" ;;
        GITBASH_CLEANUP_DAYS) echo "7" ;;
        GITBASH_PROTECTED_BRANCHES) echo "main master develop release/*" ;;
        GITBASH_REMOTE) echo "origin" ;;
        *) echo "" ;;
    esac
}

# Value of a setting stored in a specific file. Returns 1 if not set there.
file_value() {
    local file="$1" key="$2" k v
    while IFS='=' read -r k v; do
        if [[ "$k" == "$key" ]]; then
            printf '%s' "$v"
            return 0
        fi
    done < <(_gb_config_entries "$file")
    return 1
}

# Convert between the stored value and what the wizard shows.
# GITBASH_CREATE_NO_ISSUE_PARSING is stored inverted.
to_display() {
    local type="$1" value="$2"
    if [[ "$type" == "parsing" ]]; then
        [[ "$value" == "yes" ]] && echo "no" || echo "yes"
    else
        printf '%s' "$value"
    fi
}

# Validate an answer and print the value to store. Returns 1 if invalid.
to_stored() {
    local type="$1" answer="$2"
    if [[ "$answer" == *'"'* || "$answer" == *'$'* || "$answer" == *'`'* || "$answer" == *\\* ]]; then
        echo "Values cannot contain \", \$, \` or \\." >&2
        return 1
    fi
    case "$type" in
        parsing)
            case "$answer" in
                yes) echo "no" ;;
                no) echo "yes" ;;
                *) echo "Please answer yes or no." >&2; return 1 ;;
            esac
            ;;
        yesno)
            case "$answer" in
                yes|no) echo "$answer" ;;
                *) echo "Please answer yes or no." >&2; return 1 ;;
            esac
            ;;
        theme)
            case "$answer" in
                auto|dark|light) echo "$answer" ;;
                *) echo "Please answer auto, dark or light." >&2; return 1 ;;
            esac
            ;;
        number)
            if [[ "$answer" =~ ^[1-9][0-9]*$ ]]; then
                echo "$answer"
            else
                echo "Please enter a whole number of at least 1." >&2
                return 1
            fi
            ;;
        prefix)
            echo "${answer%/}"
            ;;
        *)
            echo "$answer"
            ;;
    esac
}

# Interactive configuration for one scope: global (~/.gitbashrc),
# local (<repo>/.gitbashrc, committed) or user (<repo>/.gitbashrc-user, not committed)
configure_wizard() {
    local scope="$1" file repo_root=""
    case "$scope" in
        global)
            file=$(gb_global_config_file)
            ;;
        local|user)
            if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
                print_error "Not inside a git repository."
                return 1
            fi
            if [[ "$scope" == "local" ]]; then
                file="$repo_root/.gitbashrc"
            else
                file="$repo_root/.gitbashrc-user"
            fi
            ;;
    esac

    # Effective values from all config files, used as defaults
    gb_load_config 2>/dev/null

    echo "Configure gitbash ($scope) - writes to $file"
    if [[ "$scope" == "global" ]]; then
        echo "Press Enter to keep the current value, or '-' to reset it to the default."
    else
        echo "Press Enter to keep this file's current setting, '-' to remove the override,"
        echo "or '\"\"' to override with an empty value."
    fi
    echo

    local -a lines
    local entry key type question current default answer stored has_override shown n=0
    for entry in "${SETTINGS[@]}"; do
        n=$((n + 1))
        IFS='|' read -r key type question <<< "$entry"
        [[ "$scope" == "local" && "$key" == "GITBASH_MERGE_COMMAND" ]] && continue

        default=$(setting_default "$key")
        has_override=false
        if current=$(file_value "$file" "$key"); then
            has_override=true
        elif [[ "$scope" == "global" ]]; then
            current="$default"
        fi

        echo "$n. $question"
        if [[ "$scope" == "global" ]]; then
            shown=$(to_display "$type" "$current")
        else
            shown=$(to_display "$type" "${!key}")
            if [[ "$has_override" == true ]]; then
                echo "   Current override: '$(to_display "$type" "$current")'"
            else
                echo "   Current (inherited): '$shown'"
            fi
        fi

        while true; do
            if ! prompt_read "   Value [$shown]: " answer; then
                echo "Aborted - nothing was saved."
                return 1
            fi
            if [[ -z "$answer" ]]; then
                # Keep what this file has
                if [[ "$scope" == "global" || "$has_override" == true ]]; then
                    lines+=("$key=\"$current\"")
                fi
                break
            fi
            if [[ "$answer" == "-" ]]; then
                if [[ "$scope" == "global" ]]; then
                    lines+=("$key=\"$default\"")
                fi
                break
            fi
            [[ "$answer" == '""' ]] && answer=""
            if [[ -z "$answer" && "$type" != "prefix" && "$type" != "text" ]]; then
                echo "   This setting cannot be empty." >&2
                continue
            fi
            if stored=$(to_stored "$type" "$answer"); then
                lines+=("$key=\"$stored\"")
                break
            fi
        done
        echo
    done

    if [[ "$scope" != "global" && ${#lines[@]} -eq 0 ]]; then
        if [[ -f "$file" ]]; then
            rm -f "$file"
            print_info "No overrides left - removed $file"
        else
            print_info "No overrides configured."
        fi
        return 0
    fi

    local flag="--config"
    [[ "$scope" != "global" ]] && flag="--config-$scope"
    {
        echo "# gitbash configuration ($scope). Generated by 'gitbash $flag'."
        echo "# Only plain GITBASH_*=\"value\" lines are read; nothing in this file is executed."
        [[ "$scope" == "user" ]] && echo "# Personal settings - not committed (listed in .git/info/exclude)."
        echo
        local line
        for line in ${lines[@]+"${lines[@]}"}; do
            echo "$line"
        done
    } > "$file"
    print_success "Saved $file"

    if [[ "$scope" == "user" ]]; then
        exclude_user_config
    elif [[ "$scope" == "global" ]]; then
        check_dependencies
        check_shell_integration
    fi
}

# Keep .gitbashrc-user out of git without touching the tracked .gitignore
exclude_user_config() {
    local exclude
    exclude=$(git rev-parse --git-path info/exclude 2>/dev/null) || return 0
    mkdir -p "$(dirname "$exclude")"
    if [[ -f "$exclude" ]] && grep -qxF ".gitbashrc-user" "$exclude"; then
        return 0
    fi
    # Make sure we start on a new line
    if [[ -s "$exclude" && -n "$(tail -c 1 "$exclude")" ]]; then
        echo >> "$exclude"
    fi
    echo ".gitbashrc-user" >> "$exclude"
    print_info "Added .gitbashrc-user to $exclude"
}

# Report missing optional dependencies and offer to install them with Homebrew
check_dependencies() {
    local missing=() dep
    command -v fzf >/dev/null 2>&1 || missing+=("fzf")
    command -v delta >/dev/null 2>&1 || missing+=("git-delta")
    command -v bat >/dev/null 2>&1 || command -v batcat >/dev/null 2>&1 || missing+=("bat")

    echo
    if [[ ${#missing[@]} -eq 0 ]]; then
        if require_fzf; then
            print_success "All dependencies installed."
        fi
        return 0
    fi

    echo "Missing optional dependencies: ${missing[*]}"
    echo "  fzf (>= $GB_FZF_MIN_VERSION) - interactive menus, git-delta - diff highlighting, bat - file previews"
    if ! command -v brew >/dev/null 2>&1; then
        echo "Install them with your package manager, e.g.: sudo apt install ${missing[*]}"
        return 0
    fi
    if gb_confirm "Install them with Homebrew?" y; then
        for dep in "${missing[@]}"; do
            if brew install "$dep"; then
                print_success "$dep installed"
            else
                print_error "Failed to install $dep"
            fi
        done
    fi
}

# Offer to add the shell integration to the rc file of the user's shell
check_shell_integration() {
    local shell_name shell_rc
    shell_name=$(basename "${SHELL:-}")
    case "$shell_name" in
        zsh) shell_rc="$HOME/.zshrc" ;;
        bash)
            if [[ -f "$HOME/.bashrc" ]]; then
                shell_rc="$HOME/.bashrc"
            else
                shell_rc="$HOME/.bash_profile"
            fi
            ;;
        *)
            echo
            print_info "Shell '$shell_name' is not supported for integration. Use 'gitbash <command>' or aliases."
            return 0
            ;;
    esac

    echo
    if [[ -f "$shell_rc" ]] && grep -q 'gitbash --init' "$shell_rc"; then
        print_info "Shell integration already configured in $shell_rc"
        return 0
    fi
    if gb_confirm "Add 'eval \"\$(gitbash --init)\"' to $shell_rc?" y; then
        {
            echo
            echo '# gitbash shell integration'
            # shellcheck disable=SC2016  # written literally to the rc file
            echo 'eval "$(gitbash --init)"'
        } >> "$shell_rc"
        print_success "Added to $shell_rc. Restart your shell or run 'source $shell_rc'."
    fi
}

# =============================================================================
# Help and shell integration
# =============================================================================

# ASCII art logo with a color gradient, followed by the version.
# Plain text when stdout is not a terminal or NO_COLOR is set.
show_banner() {
    local -a art=(
        '        _ _   _               _     '
        '   __ _(_) |_| |__   __ _ ___| |__  '
        '  / _` | | __| '"'"'_ \ / _` / __| '"'"'_ \ '
        ' | (_| | | |_| |_) | (_| \__ \ | | |'
        '  \__, |_|\__|_.__/ \__,_|___/_| |_|'
        '  |___/                             '
    )
    local -a colors=(214 209 204 199 170 135)
    local i
    if _gb_color_ok 1; then
        for i in "${!art[@]}"; do
            printf '\033[1;38;5;%sm%s\033[0m\n' "${colors[$i]}" "${art[$i]}"
        done
        printf '  \033[1;38;5;135mv%s\033[0m \033[2m·\033[0m Interactive git utilities for bash\n' "$VERSION"
    else
        printf '%s\n' "${art[@]}"
        printf '  v%s - Interactive git utilities for bash\n' "$VERSION"
    fi
}

show_help() {
    show_banner
    echo
    gb_help << EOF
Usage:
    gitbash <command> [args...]
    gitbash --help | --version
    gitbash --init [--prefix=PREFIX]
    gitbash --config | --config-local | --config-user

Commands:
  branch      Interactive menu for branch operations
  cleanstash  Delete stashes (multi-select)
  cleanup     Find and delete leftover local branches
  commit      Commit with optional push
  commits     List recent commits with revert option
  create      Create feature branch with Jira parsing
  pr          Open PR in browser
  repo        Open the repository in browser
  stale       List stale remote branches
  stash       Create named stash
  stashes     Interactive stash menu
  status      Interactive staging with fzf
  switch      Switch branches with fzf
  unstash     Apply stash with fzf picker
  update      Merge latest main/master into current branch

Options:
  -h, --help       Show this help message
  -v, --version    Show version number
  --init           Print shell functions for calling commands directly
                   (--prefix=gb- creates gb-commit, gb-switch, ...)
  --config         Configure gitbash and save to ~/.gitbashrc
  --config-local   Configure overrides for this repository (.gitbashrc, committed)
  --config-user    Configure personal overrides for this repository (.gitbashrc-user)

Examples:
  gitbash commit fix bug -p     # Commit and push
  gitbash switch feature        # Switch to branch containing "feature"
  gitbash create PROJ-123 fix   # Create feature/PROJ-123-fix

Shell Integration:
  Add to your .zshrc or .bashrc:
    eval "\$(gitbash --init)"

  This enables calling commands directly:
    commit fix bug -p
    switch feature

Dependencies (optional):
  fzf >= $GB_FZF_MIN_VERSION   Interactive menus (brew install fzf)
  git-delta       Better diffs (brew install git-delta)
  bat             Syntax highlighting (brew install bat)
EOF
}

# Print wrapper functions for the interactive shell. Commands still run in
# their own bash process, so nothing leaks into the user's shell.
show_init() {
    local prefix="" arg cmd bin_quoted
    for arg in "$@"; do
        case "$arg" in
            --prefix=*) prefix="${arg#--prefix=}" ;;
            *) print_error "Unknown option for --init: $arg"; return 1 ;;
        esac
    done
    if ! [[ "$prefix" =~ ^[A-Za-z0-9_-]*$ ]]; then
        print_error "Invalid prefix '$prefix' (use letters, digits, '-' or '_')."
        return 1
    fi
    printf -v bin_quoted '%q' "$GITBASH_BIN"
    echo "# gitbash shell integration - add to your .zshrc or .bashrc:"
    echo "#   eval \"\$(gitbash --init${prefix:+ --prefix=$prefix})\""
    for cmd in "${COMMANDS[@]}"; do
        echo "${prefix}${cmd}() { $bin_quoted $cmd \"\$@\"; }"
    done
}

# =============================================================================
# Main entry point
# =============================================================================

main() {
    case "${1:-}" in
        -h|--help|"")
            show_help
            ;;
        -v|--version)
            echo "gitbash $VERSION"
            ;;
        --init)
            shift
            show_init "$@"
            ;;
        --config)
            configure_wizard global
            ;;
        --config-local)
            configure_wizard local
            ;;
        --config-user)
            configure_wizard user
            ;;
        -*)
            print_error "Unknown option '$1'"
            echo "Run 'gitbash --help' for available options." >&2
            return 1
            ;;
        *)
            local cmd="$1"
            shift
            if ! is_command "$cmd"; then
                print_error "Unknown command '$cmd'"
                echo "Run 'gitbash --help' for available commands." >&2
                return 1
            fi
            gb_load_config
            # shellcheck source=/dev/null
            source "$COMMANDS_DIR/$cmd.sh"
            "$cmd" "$@"
            ;;
    esac
}

main "$@"
exit $?
